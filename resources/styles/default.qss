QWidget {
    background: transparent;
    color: #eef3f9;
    font-family: "Inter", "Noto Sans", "Segoe UI", sans-serif;
    font-size: 14px;
}

QLabel {
    background: transparent;
}

QMainWindow,
QWidget#appRoot {
    background: transparent;
}

QWidget#windowFrame {
    background: transparent;
    border: none;
    border-radius: 0;
}

QWidget#windowTitleBar {
    background: #151a21;
    border-bottom: 1px solid #27303a;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
}

QWidget#windowBody {
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
}

QWidget#contentShell,
QStackedWidget#contentPages,
QWidget#panelPage,
QScrollArea#dashboardPageScrollArea,
QScrollArea#rulesPageScrollArea,
QScrollArea#settingsPageScrollArea {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #161b22,
                                stop: 1 #1b2028);
}

QWidget#topRuntimeStrip {
    background: #161b22;
    border-bottom: 1px solid #27303a;
}

QWidget#topRuntime,
QWidget#card,
QWidget#healthItem,
QWidget#metricItem,
QWidget#editorBanner,
QWidget#editorFrame,
QWidget#fileMetaCard,
QWidget#summaryItem {
    background: #20262f;
    border: 1px solid #313a46;
    border-radius: 16px;
}

QWidget#topRuntime {
    background: rgba(255, 255, 255, 0.035);
}

QWidget#healthItem,
QWidget#metricItem,
QWidget#summaryItem,
QWidget#fileMetaCard {
    background: rgba(255, 255, 255, 0.03);
}

QWidget#bottomNav,
QWidget#bottomStatusLine,
QWidget#healthStrip {
    background: #171d24;
}

QWidget#healthStrip {
    border-top: 1px solid #2b343f;
}

QWidget#bottomNav {
    border-top: 1px solid #2b343f;
}

QWidget#bottomStatusLine {
    border-top: 1px solid #242c36;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
}

QLabel#titleBarTitle,
QLabel#panelTitle,
QLabel#cardTitleStrong,
QLabel#runtimeTitle,
QLabel#summaryValue,
QLabel#healthValue,
QLabel#selectorTriggerValue,
QLabel#selectorOptionTitle,
QLabel#recentActionValue {
    color: #f7fbff;
}

QLabel#titleBarTitle {
    font-size: 15px;
    font-weight: 600;
}

QLabel#panelTitle {
    font-size: 22px;
    font-weight: 700;
}

QLabel#cardTitleStrong {
    font-size: 17px;
    font-weight: 600;
}

QLabel#runtimeTitle {
    font-size: 15px;
    font-weight: 600;
}

QLabel#runtimeSummary,
QLabel#panelSubtitle,
QLabel#cardSubtitle,
QLabel#summarySub,
QLabel#monoNote,
QLabel#bannerMessage,
QLabel#kvValue,
QLabel#metricValue,
QLabel#selectorTriggerSub,
QLabel#selectorOptionSub,
QLabel#selectorOptionMeta {
    color: #a3adba;
}

QLabel#runtimeSummary,
QLabel#selectorOptionMeta,
QLabel#recentActionValue {
    font-size: 12px;
}

QLabel#eyebrow,
QLabel#summaryKey,
QLabel#metricLabel,
QLabel#metaLabel,
QLabel#kvKey {
    color: #7f8a98;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

QLabel#monoNote,
QLabel#metaLabel,
QLabel#kvValue,
QLabel#lineNumbers,
QLabel#selectorOptionMeta,
QLabel#ruleFileTriggerPathLabel {
    font-family: "JetBrains Mono", "Fira Code", monospace;
}

QLabel#summaryValue {
    font-size: 20px;
    font-weight: 600;
}

QLabel#selectorTriggerValue {
    font-size: 18px;
    font-weight: 600;
}

QLabel#selectorTriggerCaret {
    color: #8e99a8;
    font-size: 18px;
    font-weight: 600;
}

QLabel#recentActionValue {
    color: #c8d2dc;
    font-weight: 500;
    font-size: 12px;
}

QPushButton,
QToolButton {
    background: rgba(255, 255, 255, 0.04);
    color: #eef4fb;
    border: 1px solid #334051;
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 600;
}

QPushButton:hover,
QToolButton:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: #44546a;
}

QPushButton:pressed,
QToolButton:pressed {
    background: rgba(255, 255, 255, 0.03);
}

QPushButton#primaryButton {
    background: rgba(47, 111, 235, 0.2);
    border: 1px solid rgba(93, 149, 255, 0.68);
    color: #ffffff;
}

QPushButton#primaryButton:hover {
    background: rgba(47, 111, 235, 0.28);
}

QPushButton#ghostButton {
    background: rgba(255, 255, 255, 0.03);
}

QToolButton#navTabButton {
    min-height: 40px;
    padding: 5px 10px 5px 10px;
    border-radius: 14px;
    background: transparent;
    border: 1px solid transparent;
    color: #aab5c2;
    font-size: 14px;
    font-weight: 600;
}

QToolButton#navTabButton:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: #36414f;
}

QToolButton#navTabButton[active="true"] {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 rgba(47, 111, 235, 0.22),
                                stop: 1 rgba(255, 255, 255, 0.04));
    border-color: rgba(93, 149, 255, 0.7);
    color: #ffffff;
}

QPushButton#selectorTrigger {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 rgba(255, 255, 255, 0.055),
                                stop: 1 rgba(255, 255, 255, 0.03));
    border: 1px solid #35404d;
    border-radius: 16px;
    padding: 0;
    text-align: left;
}

QPushButton#selectorTrigger:hover {
    border-color: #475566;
}

QPushButton#selectorTrigger[open="true"] {
    border-color: rgba(93, 149, 255, 0.72);
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 rgba(47, 111, 235, 0.14),
                                stop: 1 rgba(255, 255, 255, 0.03));
}

QFrame#selectorPopup {
    background: #1c222b;
    border: 1px solid #334050;
    border-radius: 16px;
}

QPushButton#selectorOption {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 0;
    text-align: left;
}

QPushButton#selectorOption:hover,
QPushButton#selectorOption:focus {
    background: rgba(255, 255, 255, 0.05);
    border-color: #3a4657;
}

QPushButton#selectorOption[active="true"] {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 rgba(47, 111, 235, 0.18),
                                stop: 1 rgba(255, 255, 255, 0.04));
    border-color: rgba(93, 149, 255, 0.66);
}

QLabel#statusPill,
QLabel#metaChip {
    border-radius: 999px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

QLabel#metaChip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #303b48;
    color: #9eabba;
}

QLabel#statusPill[tone="ok"] {
    background: rgba(23, 163, 74, 0.16);
    border: 1px solid rgba(53, 183, 97, 0.4);
    color: #71e09b;
}

QLabel#statusPill[tone="warn"] {
    background: rgba(234, 179, 8, 0.16);
    border: 1px solid rgba(234, 179, 8, 0.36);
    color: #f2cd67;
}

QLabel#statusPill[tone="danger"] {
    background: rgba(220, 38, 38, 0.16);
    border: 1px solid rgba(220, 38, 38, 0.38);
    color: #ff8c8c;
}

QLabel#statusPill[tone="neutral"],
QLabel#statusPill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #334050;
    color: #c5d2df;
}

QWidget#editorBanner[tone="ok"] {
    background: rgba(23, 163, 74, 0.12);
    border: 1px solid rgba(53, 183, 97, 0.3);
}

QWidget#editorBanner[tone="warn"] {
    background: rgba(234, 179, 8, 0.12);
    border: 1px solid rgba(234, 179, 8, 0.28);
}

QWidget#editorBanner[tone="danger"] {
    background: rgba(220, 38, 38, 0.12);
    border: 1px solid rgba(220, 38, 38, 0.3);
}

QWidget#editorBanner[tone="neutral"],
QWidget#editorBanner {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid #313a46;
}

QLabel#bannerTitle {
    color: #f7fbff;
    font-size: 14px;
    font-weight: 600;
}

QPlainTextEdit {
    background: #171d25;
    color: #eef4fb;
    border: 1px solid #344152;
    border-radius: 16px;
}

QPlainTextEdit:hover {
    border-color: #44556e;
}

QLabel#lineNumbers {
    min-width: 42px;
    padding: 16px 10px 16px 12px;
    background: #141920;
    color: #697687;
    border-right: 1px solid #2a3340;
}

QPlainTextEdit#ruleEditor,
QPlainTextEdit#settingsEditor {
    border-radius: 0;
    border: none;
    padding: 16px 18px;
    selection-background-color: rgba(47, 111, 235, 0.38);
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 13px;
}

QPlainTextEdit#settingsEditor {
    border: 1px solid #344152;
    border-radius: 16px;
    min-height: 420px;
}

QLabel#kvValue {
    font-size: 13px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QWidget#pageViewport {
    background: transparent;
}

QLabel#healthValue {
    font-size: 12px;
    font-weight: 600;
}

QStatusBar {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #3a475b;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}

QPlainTextEdit QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 4px;
}

QPlainTextEdit QScrollBar::handle:horizontal {
    background: #3a475b;
    border-radius: 6px;
    min-width: 28px;
}

QPlainTextEdit QScrollBar::add-line:horizontal,
QPlainTextEdit QScrollBar::sub-line:horizontal,
QPlainTextEdit QScrollBar::add-page:horizontal,
QPlainTextEdit QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
}
